{
  "manifest_version": 3,
  "name": "AutoTab Organizer",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Group tabs by domain rules into Chrome tab groups, including one-click organize for large windows.",
  "permissions": ["tabs", "tabGroups", "storage"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AutoTab Organizer",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
